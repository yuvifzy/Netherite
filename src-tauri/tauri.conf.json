{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Netherite",
  "version": "1.0.0",
  "identifier": "com.netherite.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Netherite",
        "width": 360,
        "height": 260,
        "minWidth": 360,
        "minHeight": 160,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "skipTaskbar": true,
        "visible": true,
        "backgroundColor": "#00000000"
      },
      {
        "title": "todo",
        "width": 320,
        "height": 420,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "skipTaskbar": true,
        "visible": false,
        "backgroundColor": "#00000000",
        "url": "/?window=todo"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "12.0"
    },
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}